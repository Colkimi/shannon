# Shannon Environment Configuration
# Copy this file to .env and fill in your values

# Anthropic API Key (required)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# Optional: Claude Code OAuth Token
# CLAUDE_CODE_OAUTH_TOKEN=

# Max output tokens for Claude responses
# Recommended: 64000 to prevent token limits during long reports
CLAUDE_CODE_MAX_OUTPUT_TOKENS=64000

# Debug mode (for development)
# WARNING: Contains sensitive flag for testing - do not use in production!
# DEBUG_MODE=true
# TEST_FLAG=genius{os3t
